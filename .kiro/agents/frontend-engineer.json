{
  "name": "frontend-engineer",
  "description": "Frontend engineer. Builds the war-room UI (map, agent glass box, approval inbox) and citizen page with React 19, shadcn/ui, FAST's AG-UI client, Motion and MapLibre on Amazon Location maps, and verifies them in a real browser. Use for frontend/.",
  "prompt": "file://./prompts/frontend-engineer.md",
  "tools": [
    "read",
    "write",
    "shell",
    "@context7",
    "@shadcn",
    "@chrome-devtools",
    "@fetch"
  ],
  "allowedTools": [
    "read"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "frontend/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "npm *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "npx vite*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "npx vitest*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "npx playwright*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "npx shadcn*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "python .kiro/skills/ui-ux-pro/scripts/*"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          ".kiroster/ledger/**",
          ".kiro/agents/**",
          ".kiro/hooks/**",
          ".env*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git push --force*",
          "git push -f*",
          "rm -rf *",
          "sudo *",
          "aws * delete*",
          "aws * terminate*",
          "cdk destroy*",
          "terraform destroy*"
        ],
        "effect": "deny"
      }
    ]
  },
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "timeout": 120000
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "-y",
        "shadcn@latest",
        "mcp"
      ],
      "timeout": 120000
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "timeout": 120000
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "timeout": 120000
    }
  },
  "includeMcpJson": false,
  "resources": [
    "file://.kiro/steering/**/*.md",
    "file://docs/BLUEPRINT.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "node scripts/hooks/trail.mjs --agent frontend-engineer"
      },
      {
        "matcher": "execute_bash",
        "command": "node scripts/hooks/trail.mjs --agent frontend-engineer"
      }
    ]
  }
}
