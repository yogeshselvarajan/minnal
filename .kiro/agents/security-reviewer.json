{
  "name": "security-reviewer",
  "description": "Independent security reviewer, owner of the security-review gate. Read-only. Reviews IAM least privilege, Gateway auth, Cedar policies, guardrails, prompt-injection handling, secrets and dependencies using the IAM, Well-Architected security and CloudTrail MCP servers. Ends with PASS or NEEDS_CHANGES.",
  "prompt": "file://./prompts/security-reviewer.md",
  "tools": [
    "read",
    "write",
    "shell",
    "@iam",
    "@wa-security",
    "@cloudtrail"
  ],
  "allowedTools": [
    "read"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "docs/reviews/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git diff*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git log*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "npm audit*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "uv pip audit*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "npx cdk-nag*"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          ".kiroster/ledger/**",
          ".kiro/agents/**",
          ".kiro/hooks/**",
          ".env*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git push --force*",
          "git push -f*",
          "rm -rf *",
          "sudo *",
          "aws * delete*",
          "aws * terminate*",
          "cdk destroy*",
          "terraform destroy*"
        ],
        "effect": "deny"
      }
    ]
  },
  "mcpServers": {
    "iam": {
      "command": "uvx",
      "args": [
        "awslabs.iam-mcp-server@latest",
        "--readonly"
      ],
      "env": {
        "AWS_PROFILE": "minnal-readonly",
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "timeout": 120000
    },
    "wa-security": {
      "command": "uvx",
      "args": [
        "awslabs.well-architected-security-mcp-server@latest"
      ],
      "env": {
        "AWS_PROFILE": "minnal-readonly",
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "timeout": 120000
    },
    "cloudtrail": {
      "command": "uvx",
      "args": [
        "awslabs.cloudtrail-mcp-server@latest"
      ],
      "env": {
        "AWS_PROFILE": "minnal-readonly",
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "timeout": 120000
    }
  },
  "includeMcpJson": false,
  "resources": [
    "file://.kiro/steering/**/*.md",
    "file://docs/BLUEPRINT.md",
    "skill://.kiro/skills/**/SKILL.md"
  ],
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "node scripts/hooks/trail.mjs --agent security-reviewer"
      },
      {
        "matcher": "execute_bash",
        "command": "node scripts/hooks/trail.mjs --agent security-reviewer"
      }
    ]
  }
}
