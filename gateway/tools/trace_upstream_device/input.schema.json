{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minnal.dev/schemas/tools/trace_upstream_device.input.json",
  "title": "TraceUpstreamDeviceInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "outage_ids"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "pattern": "^inc_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^corr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "outage_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^out_[0-9A-HJKMNP-TV-Z]{26}$"
      }
    }
  }
}
